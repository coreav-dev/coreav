{
  "name": "@coreav/wasm",
  "version": "0.0.1",
  "description": "CoreAV probe and stream-copy operations as a WebAssembly library with JSPI",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreav-dev/coreav.git",
    "directory": "packages/wasm"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./workers": {
      "types": "./src/workers.d.ts",
      "default": "./src/workers.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "default": "./src/node.js"
    }
  },
  "files": [
    "src",
    "wasm/coreav.js",
    "wasm/build.js",
    "wasm/coreav_bg.wasm",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node --test test/sources.test.mjs test/http.test.mjs test/r2.test.mjs test/errors.test.mjs test/build.test.mjs",
    "test:module": "node --experimental-wasm-jspi --experimental-wasm-exnref --test test/module.test.mjs test/streams.test.mjs",
    "test:types": "node scripts/check-types.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
