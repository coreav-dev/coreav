# The one pin of the oracle FFmpeg: the ffmpeg and ffprobe that CI, the
# fixture comparisons, the fallback name listings and the transcode bars run
# as black boxes. Every script and workflow reads it from here;
# scripts/oracle_pin_check.py fails on a second pin. Lines are NAME=value,
# read by bash (`source`) and by Python (scripts/oracle_pin.py).
#
# FFmpeg 9.0.2, the BtbN Linux x86_64 GPL static build of the 9.0 release
# branch kept with the autobuild of 2026-09-30: the latest stable release
# with its first 17 release-branch fixes. The H.264 speed rounds time the
# same build. SHA256 is the archive's; only bin/ffmpeg and bin/ffprobe are
# extracted from it.
VERSION=9.0.2
BUILD=n9.0.2-17-g2a571b6068
ARCHIVE=ffmpeg-n9.0.2-17-g2a571b6068-linux64-gpl-9.0
URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-09-30-13-08/ffmpeg-n9.0.2-17-g2a571b6068-linux64-gpl-9.0.tar.xz
SHA256=68ee646831adaae2495618346f3bba94ff207ff83bbd34d643e7004730d66269
# The LGPL shared build of the same release from the same autobuild, whose
# libraries tools/ts-speed/build-lav.sh links for libavformat's side of the
# packet-listing speed bar.
LAV_ARCHIVE=ffmpeg-n9.0.2-17-g2a571b6068-linux64-lgpl-shared-9.0
LAV_SHA256=7a1ba2af36e5beeb98151e766a903b1d115f2206a86571f17f873cd7292c424f
# The libx264 that build links (x264 core 165), from which
# scripts/install-x264.sh builds the x264 program, so that both encoders of
# `coreav transcode` are the same encoder.
X264_COMMIT=0480cb05fa188d37ae87e8f4fd8f1aea3711f7ee
