{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreav-dev/coreav/docs/schema/transcode-v1.schema.json",
  "title": "coreav transcode summary, schema coreav.transcode/1",
  "description": "The summary coreav transcode prints (docs/design/transcode.md). Keys and meanings: docs/schema/transcode-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "output", "video", "audio", "other", "dropped"],
  "properties": {
    "schema": {"const": "coreav.transcode/1"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_index",
        "codec",
        "frames",
        "dropped_frames",
        "not_presented",
        "backend",
        "encoder",
        "width",
        "height",
        "sample_aspect",
        "frame_rate"
      ],
      "properties": {
        "stream_index": {"type": "integer", "minimum": 0},
        "codec": {"enum": ["h264", "hevc", "av1", "vp9", "vp8", "prores", "mpeg4", "mpeg1video", "mpeg2video", "mjpeg", "theora", "ffv1"]},
        "frames": {"type": "integer", "minimum": 1},
        "dropped_frames": {"type": "integer", "minimum": 0},
        "not_presented": {"type": "integer", "minimum": 0},
        "backend": {"enum": ["nvdec", "native", "dav1d", "ffmpeg"]},
        "encoder": {"enum": ["x264", "ffmpeg"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "sample_aspect": {"type": ["string", "null"]},
        "frame_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["num", "den"],
          "properties": {
            "num": {"type": "integer", "minimum": 1},
            "den": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream_index", "codec"],
        "properties": {
          "stream_index": {"type": "integer", "minimum": 0},
          "codec": {"type": "string"}
        }
      }
    },
    "other": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream_index", "kind", "codec"],
        "properties": {
          "stream_index": {"type": "integer", "minimum": 0},
          "kind": {"type": "string"},
          "codec": {"type": "string"}
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream_index", "reason", "message"],
        "properties": {
          "stream_index": {"type": "integer", "minimum": 0},
          "reason": {"enum": ["not_selected", "codec_not_allowed", "unsupported"]},
          "message": {"type": ["string", "null"]}
        }
      }
    }
  }
}
