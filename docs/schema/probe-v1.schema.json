{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreav-dev/coreav/docs/schema/probe-v1.schema.json",
  "title": "coreav.probe/1",
  "description": "Output of `coreav probe`. Every key is always present; unknown values are null. Documented in probe-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "file", "container", "duration", "presentation_duration", "streams", "dropped_streams", "warnings"],
  "properties": {
    "schema": {"const": "coreav.probe/1"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {"size": {"type": "integer", "minimum": 0}}
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major_brand", "fragmented", "timescale", "creation_time"],
      "properties": {
        "major_brand": {"type": ["string", "null"]},
        "fragmented": {"type": "boolean"},
        "timescale": {"type": "integer", "minimum": 0},
        "creation_time": {"type": ["string", "null"]}
      }
    },
    "duration": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "presentation_duration": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "streams": {"type": "array", "items": {"$ref": "#/$defs/stream"}},
    "dropped_streams": {"type": "array", "items": {"$ref": "#/$defs/dropped"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "picture_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": {"type": "integer"},
        "den": {"type": "integer", "minimum": 1}
      }
    },
    "stored_ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": {"type": "integer", "minimum": 0},
        "den": {"type": "integer", "minimum": 0}
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticks", "timescale", "seconds"],
      "properties": {
        "ticks": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
        "timescale": {"type": "integer", "minimum": 0},
        "seconds": {"type": ["number", "null"]}
      }
    },
    "dropped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_index", "track_id", "fourcc", "reason"],
      "properties": {
        "stream_index": {"type": "integer", "minimum": 0},
        "track_id": {"type": "integer", "minimum": 0},
        "fourcc": {"type": "string"},
        "reason": {"enum": ["codec_not_allowed"]}
      }
    },
    "edit_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_duration", "media_time", "media_rate"],
      "properties": {
        "segment_duration": {"type": "integer", "minimum": 0},
        "media_time": {"type": "integer"},
        "media_rate": {"type": "integer"}
      }
    },
    "edit_list": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "entries"],
          "properties": {
            "type": {"enum": ["none", "multiple", "unsupported"]},
            "entries": {"type": "array", "items": {"$ref": "#/$defs/edit_entry"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "empty", "media_time", "segment", "entries"],
          "properties": {
            "type": {"const": "simple"},
            "empty": {"type": "integer", "minimum": 0},
            "media_time": {"type": "integer"},
            "segment": {"type": "integer", "minimum": 0},
            "entries": {"type": "array", "items": {"$ref": "#/$defs/edit_entry"}}
          }
        }
      ]
    },
    "declared_bit_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "average", "maximum", "buffer_size"],
      "properties": {
        "source": {"type": "string"},
        "average": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0},
        "buffer_size": {"type": "integer", "minimum": 0}
      }
    },
    "bit_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "bits_per_second"],
      "properties": {
        "exact": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
        "bits_per_second": {"type": ["number", "null"]}
      }
    },
    "profile": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "profile_idc", "constraint_flags", "level_idc"],
          "properties": {
            "type": {"const": "h264"},
            "name": {"type": ["string", "null"]},
            "profile_idc": {"type": "integer", "minimum": 0},
            "constraint_flags": {"type": "integer", "minimum": 0},
            "level_idc": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "profile_space", "high_tier", "profile_idc",
                       "compatibility_flags", "constraint_flags", "level_idc"],
          "properties": {
            "type": {"const": "hevc"},
            "name": {"type": ["string", "null"]},
            "profile_space": {"type": "integer", "minimum": 0},
            "high_tier": {"type": "boolean"},
            "profile_idc": {"type": "integer", "minimum": 0},
            "compatibility_flags": {"type": "integer", "minimum": 0},
            "constraint_flags": {"type": "integer", "minimum": 0},
            "level_idc": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "profile", "level_idx", "high_tier", "high_bitdepth",
                       "twelve_bit", "monochrome"],
          "properties": {
            "type": {"const": "av1"},
            "name": {"type": ["string", "null"]},
            "profile": {"type": "integer", "minimum": 0},
            "level_idx": {"type": "integer", "minimum": 0},
            "high_tier": {"type": "boolean"},
            "high_bitdepth": {"type": "boolean"},
            "twelve_bit": {"type": "boolean"},
            "monochrome": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "profile", "level", "bit_depth"],
          "properties": {
            "type": {"const": "vp9"},
            "name": {"type": ["string", "null"]},
            "profile": {"type": "integer", "minimum": 0},
            "level": {"type": "integer", "minimum": 0},
            "bit_depth": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "object_type", "sbr", "ps"],
          "properties": {
            "type": {"const": "aac"},
            "name": {"type": ["string", "null"]},
            "object_type": {"type": "integer", "minimum": 0},
            "sbr": {"type": "boolean"},
            "ps": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": {"const": "prores"},
            "name": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "parameter_set_size", "scanned_size", "pixel_aspect",
                   "rotation", "matrix", "color", "parameter_set_color"],
      "properties": {
        "width": {"type": ["integer", "null"], "minimum": 0},
        "height": {"type": ["integer", "null"], "minimum": 0},
        "parameter_set_size": {"anyOf": [{"$ref": "#/$defs/picture_size"}, {"type": "null"}]},
        "scanned_size": {"anyOf": [{"$ref": "#/$defs/picture_size"}, {"type": "null"}]},
        "pixel_aspect": {"anyOf": [{"$ref": "#/$defs/stored_ratio"}, {"type": "null"}]},
        "rotation": {"anyOf": [{"enum": [0, 90, 180, 270]}, {"type": "null"}]},
        "matrix": {"type": "array", "items": {"type": "integer"}},
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primaries", "transfer", "matrix", "full_range"],
          "properties": {
            "primaries": {"type": ["integer", "null"], "minimum": 0},
            "transfer": {"type": ["integer", "null"], "minimum": 0},
            "matrix": {"type": ["integer", "null"], "minimum": 0},
            "full_range": {"type": ["boolean", "null"]}
          }
        },
        "parameter_set_color": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["primaries", "transfer", "matrix", "full_range"],
          "properties": {
            "primaries": {"type": ["integer", "null"], "minimum": 0},
            "transfer": {"type": ["integer", "null"], "minimum": 0},
            "matrix": {"type": ["integer", "null"], "minimum": 0},
            "full_range": {"type": ["boolean", "null"]}
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "implicit_ps_possible", "sample_rate", "pcm"],
      "properties": {
        "channels": {"type": ["integer", "null"], "minimum": 0},
        "implicit_ps_possible": {"type": "boolean"},
        "sample_rate": {"type": ["integer", "null"], "minimum": 0},
        "pcm": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["float", "bits", "little_endian", "signed"],
              "properties": {
                "float": {"type": "boolean"},
                "bits": {"type": "integer", "minimum": 0},
                "little_endian": {"type": "boolean"},
                "signed": {"type": "boolean"}
              }
            },
            {"type": "null"}
          ]
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "stream_index", "track_id", "kind", "codec", "fourcc", "handler",
                   "handler_name", "language", "timescale", "duration", "duration_source",
                   "sample_count", "sample_descriptions", "bit_rate", "declared_bit_rate",
                   "profile", "edit_list", "creation_time", "external_data", "tables_valid",
                   "video", "audio", "warnings"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "stream_index": {"type": "integer", "minimum": 0},
        "track_id": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["video", "audio", "subtitle", "timecode", "data"]},
        "codec": {"enum": ["h264", "hevc", "av1", "vp9", "prores", "aac", "mp3", "opus", "flac",
                           "alac", "ac3", "eac3", "pcm", "timed_text", "timecode", "other"]},
        "fourcc": {"type": "string"},
        "handler": {"type": "string"},
        "handler_name": {"type": ["string", "null"]},
        "language": {"type": ["string", "null"]},
        "timescale": {"type": "integer", "minimum": 0},
        "duration": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "duration_source": {"enum": ["media_header", "media_edit", "observed", "unknown"]},
        "sample_count": {"type": ["integer", "null"], "minimum": 0},
        "sample_descriptions": {"type": "integer", "minimum": 0},
        "bit_rate": {"anyOf": [{"$ref": "#/$defs/bit_rate"}, {"type": "null"}]},
        "declared_bit_rate": {"anyOf": [{"$ref": "#/$defs/declared_bit_rate"}, {"type": "null"}]},
        "profile": {"anyOf": [{"$ref": "#/$defs/profile"}, {"type": "null"}]},
        "edit_list": {"$ref": "#/$defs/edit_list"},
        "creation_time": {"type": ["string", "null"]},
        "external_data": {"type": "boolean"},
        "tables_valid": {"type": "boolean"},
        "video": {"anyOf": [{"$ref": "#/$defs/video"}, {"type": "null"}]},
        "audio": {"anyOf": [{"$ref": "#/$defs/audio"}, {"type": "null"}]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
