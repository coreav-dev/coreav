{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreav-dev/coreav/docs/schema/remux-v1.schema.json",
  "title": "coreav remux summary, schema coreav.remux/1",
  "description": "The summary coreav remux and coreav sanitize print (docs/design/remux.md, docs/design/sanitize.md). Keys and meanings: docs/schema/remux-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "output",
    "metadata",
    "source",
    "streams",
    "dropped_streams",
    "dropped_boxes",
    "dropped_boxes_not_listed",
    "cleared"
  ],
  "properties": {
    "schema": {
      "const": "coreav.remux/1"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moov_first",
        "truncated_at"
      ],
      "properties": {
        "moov_first": {
          "type": "boolean"
        },
        "truncated_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stream"
      }
    },
    "dropped_streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dropped_stream"
      }
    },
    "dropped_boxes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dropped_box"
      }
    },
    "dropped_boxes_not_listed": {
      "type": "integer",
      "minimum": 0
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "keep"
      ],
      "properties": {
        "mode": {
          "enum": [
            "copy",
            "sanitize"
          ]
        },
        "keep": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "enum": [
                  "rotation",
                  "language",
                  "dates",
                  "gapless",
                  "kinds"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cleared": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cleared"
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer"
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticks",
        "timescale",
        "seconds"
      ],
      "properties": {
        "ticks": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "timescale": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "stream_index",
        "source_track_id",
        "track_id",
        "codec",
        "samples",
        "duration",
        "annex_b"
      ],
      "properties": {
        "kind": {
          "enum": [
            "video",
            "audio",
            "subtitle",
            "timecode",
            "data"
          ]
        },
        "stream_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_track_id": {
          "type": "integer",
          "minimum": 0
        },
        "track_id": {
          "type": "integer",
          "minimum": 1
        },
        "codec": {
          "anyOf": [
            {
              "enum": [
                "h264",
                "hevc",
                "av1",
                "vp9",
                "aac",
                "mp3",
                "opus"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "$ref": "#/$defs/time"
        },
        "annex_b": {
          "type": "boolean"
        }
      }
    },
    "dropped_stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_index",
        "track_id",
        "reason",
        "message"
      ],
      "properties": {
        "stream_index": {
          "type": "integer",
          "minimum": 0
        },
        "track_id": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "not_selected",
            "codec_not_allowed",
            "unsupported"
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "dropped_box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_index",
        "path",
        "offset",
        "size",
        "reason",
        "kind",
        "name"
      ],
      "properties": {
        "stream_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "not_carried",
            "too_large",
            "sanitized"
          ]
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "location",
                "device",
                "date",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cleared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_index",
        "field"
      ],
      "properties": {
        "stream_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "field": {
          "enum": [
            "creation_time",
            "rotation",
            "language",
            "compressor_name",
            "sample_entry_extras",
            "spherical_source"
          ]
        }
      }
    }
  }
}
