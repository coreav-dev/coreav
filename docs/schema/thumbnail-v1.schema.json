{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreav-dev/coreav/docs/schema/thumbnail-v1.schema.json",
  "title": "coreav thumbnail summary, schema coreav.thumbnail/1",
  "description": "The summary coreav thumbnail prints (docs/design/thumbnails.md). Keys and meanings: docs/schema/thumbnail-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "output",
    "time",
    "stream_index",
    "codec",
    "keyframe",
    "packet",
    "packets_decoded",
    "decoder",
    "warnings",
    "skipped"
  ],
  "properties": {
    "schema": {
      "const": "coreav.thumbnail/1"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "format", "width", "height"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "format": {"enum": ["jpeg", "png", "webp"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "frame", "frame_seconds", "decode_start"],
      "properties": {
        "requested": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
        "frame": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]},
        "frame_seconds": {"type": "number"},
        "decode_start": {"anyOf": [{"$ref": "#/$defs/rational"}, {"type": "null"}]}
      }
    },
    "stream_index": {"type": "integer", "minimum": 0},
    "codec": {"enum": ["h264", "hevc", "av1", "vp9", "vp8", "prores", "mpeg4", "mpeg1video", "mpeg2video", "mjpeg", "theora", "ffv1"]},
    "keyframe": {"type": "boolean"},
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "size"],
      "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "packets_decoded": {"type": "integer", "minimum": 1},
    "decoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "name", "isolation", "fell_back"],
      "properties": {
        "backend": {"enum": ["nvdec", "native", "dav1d", "libvpx", "ffmpeg"]},
        "name": {"type": "string"},
        "isolation": {"enum": ["in_process", "sandboxed"]},
        "fell_back": {"type": "boolean"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "reason"],
        "properties": {
          "backend": {"enum": ["nvdec", "native", "dav1d", "libvpx", "ffmpeg"]},
          "reason": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": {"type": "integer"},
        "den": {"type": "integer", "minimum": 1}
      }
    }
  }
}
