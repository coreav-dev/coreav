{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreav-dev/coreav/docs/schema/chapters-v1.schema.json",
  "title": "coreav chapters output, schema coreav.chapters/1",
  "description": "The chapter list coreav chapters prints (docs/design/text.md). Keys and meanings: docs/schema/chapters-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stream",
    "chapters",
    "samples",
    "dropped"
  ],
  "properties": {
    "schema": {
      "const": "coreav.chapters/1"
    },
    "stream": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stream_index",
            "track_id",
            "codec"
          ],
          "properties": {
            "stream_index": {
              "type": "integer",
              "minimum": 0
            },
            "track_id": {
              "type": "integer",
              "minimum": 0
            },
            "codec": {
              "enum": [
                "timed_text",
                "quicktime_text"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "samples": {
      "type": "integer",
      "minimum": 0
    },
    "dropped": {
      "$ref": "#/$defs/dropped"
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "title"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer"
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticks",
        "timescale",
        "seconds"
      ],
      "properties": {
        "ticks": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "timescale": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "dropped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "empty",
        "not_presented",
        "too_short",
        "malformed",
        "invalid_text",
        "trailing_bytes",
        "styling"
      ],
      "properties": {
        "empty": {
          "type": "integer",
          "minimum": 0
        },
        "not_presented": {
          "type": "integer",
          "minimum": 0
        },
        "too_short": {
          "type": "integer",
          "minimum": 0
        },
        "malformed": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_text": {
          "type": "integer",
          "minimum": 0
        },
        "trailing_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "styling": {
          "$ref": "#/$defs/styling"
        }
      }
    },
    "styling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "styl",
        "hlit",
        "hclr",
        "krok",
        "dlay",
        "href",
        "tbox",
        "blnk",
        "twrp",
        "disp",
        "other"
      ],
      "properties": {
        "styl": {
          "type": "integer",
          "minimum": 0
        },
        "hlit": {
          "type": "integer",
          "minimum": 0
        },
        "hclr": {
          "type": "integer",
          "minimum": 0
        },
        "krok": {
          "type": "integer",
          "minimum": 0
        },
        "dlay": {
          "type": "integer",
          "minimum": 0
        },
        "href": {
          "type": "integer",
          "minimum": 0
        },
        "tbox": {
          "type": "integer",
          "minimum": 0
        },
        "blnk": {
          "type": "integer",
          "minimum": 0
        },
        "twrp": {
          "type": "integer",
          "minimum": 0
        },
        "disp": {
          "type": "integer",
          "minimum": 0
        },
        "other": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
