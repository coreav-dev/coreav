{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreav-dev/coreav/docs/schema/join-v1.schema.json",
  "title": "coreav join summary, schema coreav.join/1",
  "description": "The summary coreav join prints (docs/design/join.md). Keys and meanings: docs/schema/join-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "output",
    "duration",
    "edits",
    "inputs",
    "boxes_left_out"
  ],
  "properties": {
    "schema": {
      "const": "coreav.join/1"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "duration": {
      "$ref": "#/$defs/time"
    },
    "edits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video",
        "audio"
      ],
      "properties": {
        "video": {
          "type": "integer",
          "minimum": 0
        },
        "audio": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "boxes_left_out": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer"
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticks",
        "timescale",
        "seconds"
      ],
      "properties": {
        "ticks": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "timescale": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "stream_index",
        "track_id",
        "codec",
        "first_sample",
        "samples",
        "duration"
      ],
      "properties": {
        "kind": {
          "enum": [
            "video",
            "audio"
          ]
        },
        "stream_index": {
          "type": "integer",
          "minimum": 0
        },
        "track_id": {
          "type": "integer",
          "minimum": 0
        },
        "codec": {
          "anyOf": [
            {
              "enum": [
                "h264",
                "hevc",
                "av1",
                "vp9",
                "aac"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "first_sample": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "duration": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "left_out": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_index",
        "track_id",
        "reason"
      ],
      "properties": {
        "stream_index": {
          "type": "integer",
          "minimum": 0
        },
        "track_id": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "not_selected",
            "no_samples_in_clip",
            "codec_not_allowed"
          ]
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "path",
        "offset",
        "video_start",
        "video_end",
        "extended",
        "streams",
        "left_out"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "offset": {
          "$ref": "#/$defs/time"
        },
        "video_start": {
          "$ref": "#/$defs/time"
        },
        "video_end": {
          "$ref": "#/$defs/time"
        },
        "extended": {
          "type": "integer",
          "minimum": 0
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stream"
          }
        },
        "left_out": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/left_out"
          }
        }
      }
    }
  }
}
