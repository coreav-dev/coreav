+static HIST: [std::sync::atomic::AtomicU64; 5 * 5 * 4 * 4 * 3] = [const { std::sync::atomic::AtomicU64::new(0) }; 5 * 5 * 4 * 4 * 3];
+fn hist_note(w: usize, h: usize, xf: u8, yf: u8, kind: usize) {
+    let i = |v: usize| match v { 2 => 0, 4 => 1, 8 => 2, 16 => 3, _ => 4 };
+    let k = (((kind * 5 + i(w)) * 5 + i(h)) * 4 + usize::from(xf & 3)) * 4 + usize::from(yf & 3);
+    if let Some(c) = HIST.get(k) { c.fetch_add(1, std::sync::atomic::Ordering::Relaxed); }
+}
+/// Histogram dump.
+pub fn hist_dump() {
+    let n = [2, 4, 8, 16, 0];
+    for (k, c) in HIST.iter().enumerate() {
+        let v = c.load(std::sync::atomic::Ordering::Relaxed);
+        if v == 0 { continue; }
+        let (yf, r) = (k % 4, k / 4); let (xf, r) = (r % 4, r / 4); let (hi, r) = (r % 5, r / 5); let (wi, kind) = (r % 5, r / 5);
+        eprintln!("H {kind} {} {} {xf} {yf} {v}", n[wi], n[hi]);
+    }
+}
