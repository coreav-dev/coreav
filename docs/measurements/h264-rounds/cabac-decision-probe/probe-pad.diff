+
+/// Probe only (not for merge): twelve independent one-uop instructions,
+/// the part a smaller DecodeDecision would remove, added to every regular
+/// bin.
+#[inline(always)]
+pub(crate) fn pad(a: u64) {
+    // SAFETY: register arithmetic only; no memory, stack or flags.
+    unsafe {
+        core::arch::asm!(
+            "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]",
+            "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]",
+            "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]",
+            "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]",
+            o = out(reg) _, a = in(reg) a, options(nomem, nostack, preserves_flags)
+        );
+    }
+}
