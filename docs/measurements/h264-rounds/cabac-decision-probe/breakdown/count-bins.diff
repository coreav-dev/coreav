 //! ```
 
 mod bits;
+#[doc(hidden)]
+pub mod count {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    pub static BINS: [AtomicU64; 1040] = [const { AtomicU64::new(0) }; 1040];
+    #[inline(always)]
+    pub(crate) fn add(i: usize) {
+        if let Some(c) = BINS.get(i) {
+            c.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+    pub fn dump() {
+        let v: Vec<String> = BINS.iter().enumerate().filter_map(|(i, c)| {
+            let n = c.load(Ordering::Relaxed);
+            (n != 0).then(|| format!("{i}:{n}"))
+        }).collect();
+        eprintln!("BINS {}", v.join(" "));
+    }
+}
 mod cabac;
 mod cavlc;
 mod deblock;
