+    /// The two-level tables decode every 16-bit window as a scan of the
+    /// code words of clause 9.2 does: the word that is a prefix of it, or
+    /// no word.
+    #[test]
+    fn two_levels_decode_every_window_as_a_scan_of_the_words() {
+        let c = codes();
+        let one = |table: &'static [(u8, u32, u8)]| -> Vec<(u8, u32, u8, u8)> {
+            table.iter().map(|&(len, code, v)| (len, code, v, 0)).collect()
+        };
+        let mut sets: Vec<(&Code, Vec<(u8, u32, u8, u8)>)> = Vec::new();
+        for (code, table) in c.coeff_token.iter().zip(t::COEFF_TOKEN.iter()) {
+            sets.push((code, table.to_vec()));
+        }
+        for (code, table) in c.total_zeros.iter().zip(t::TOTAL_ZEROS_4X4.iter()) {
+            sets.push((code, one(table)));
+        }
+        for (code, table) in c.total_zeros_chroma_dc.iter().zip(t::TOTAL_ZEROS_CHROMA_DC_2X2.iter()) {
+            sets.push((code, one(table)));
+        }
+        for (code, table) in c.run_before.iter().zip(t::RUN_BEFORE.iter()) {
+            sets.push((code, one(table)));
+        }
