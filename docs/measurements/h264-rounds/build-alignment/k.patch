diff --git a/.cargo/config.toml b/.cargo/config.toml
new file mode 100644
index 0000000..63a2766
--- /dev/null
+++ b/.cargo/config.toml
@@ -0,0 +1,9 @@
+# Code placement (docs/design/h264.md, "Build round: code alignment"): every
+# function starts on a 64-byte line and every loop head is aligned to 64
+# bytes, on x86-64 only, where it was measured. Cargo reads this file from the
+# repository's tree, so it covers builds made in it: the CI release binaries
+# and wheels, the benchmark builds. It is ignored when RUSTFLAGS or
+# CARGO_ENCODED_RUSTFLAGS is set, which is why packages/cli/scripts/platform.sh
+# names the flags itself where it sets RUSTFLAGS.
+[target.'cfg(target_arch = "x86_64")']
+rustflags = ["-C", "llvm-args=-align-all-functions=6", "-C", "llvm-args=-align-loops=64"]
