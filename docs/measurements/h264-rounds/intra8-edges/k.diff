+/// One 8x8 block of [`intra8x8_mb`]: its prediction from `edges`, the row
+/// above (p[0..15, -1], its top right still to be repeated where `avail`
+/// has none), the column left (p[-1, 0..7], low eight bytes) and p[-1, -1],
+/// each zero where `avail` names no such neighbour; then its residual added
+/// where `coded`. Rows 0 to 7, two to a vector.
+///
+/// # Safety
+///
+/// AVX2 must be available; inlined only into `intra8x8_mb`, which enables
+/// it.
+#[inline(always)]
+unsafe fn block8x8(
+    mode: u8,
+    avail: IntraAvail,
+    edges: (__m128i, __m128i, u8),
+    coeffs: &[i32; 64],
+    coded: bool,
+) -> [__m128i; 4] {
+    // SAFETY: AVX2 is available (the caller's contract); register
+    // operations, and the transform's reads of `coeffs`.
+    unsafe {
+        let (mut top, left, corner) = edges;
+        if !avail.top_right {
+            let repeat = _mm_setr_epi8(0, 1, 2, 3, 4, 5, 6, 7, 7, 7, 7, 7, 7, 7, 7, 7);
+            top = _mm_shuffle_epi8(top, repeat);
+        }
+        let left = _mm_cvtsi128_si64(left) as u64;
+        let [first, second] = predict8x8(mode, avail, top, left, corner);
+        let rows = [
+            _mm256_castsi256_si128(first),
+            _mm256_extracti128_si256::<1>(first),
+            _mm256_castsi256_si128(second),
+            _mm256_extracti128_si256::<1>(second),
+        ];
+        if !coded {
+            return rows;
+        }
+        let [g0, g1, g2, g3, g4, g5, g6, g7] = idct8x8(coeffs);
+        let [r0, r1, r2, r3] = rows;
+        let [r0, r1] = add_residual8([r0, r1], [g0, g1, g2, g3]);
+        let [r2, r3] = add_residual8([r2, r3], [g4, g5, g6, g7]);
+        [r0, r1, r2, r3]
+    }
+}
