+/// p[-1, 0..7] of a block, the column of eight samples down from `at`, as
+/// the low eight bytes of a vector (the others zero): one insert a sample,
+/// each sample's address one stride on from the last.
+///
+/// # Safety
+///
+/// AVX2 must be available, and the eight samples `at`, `at + stride`, ...,
+/// `at + 7 * stride` inside one allocation.
+#[inline(always)]
+unsafe fn column8(at: *const u8, stride: usize) -> __m128i {
+    // SAFETY: AVX2 (and so SSE4.1) is available and each read is one of
+    // the eight samples (the caller's contract).
+    unsafe {
+        let p = |k: usize| i32::from(*at.add(k * stride));
+        let v = _mm_cvtsi32_si128(p(0));
+        let v = _mm_insert_epi8::<1>(v, p(1));
+        let v = _mm_insert_epi8::<2>(v, p(2));
+        let v = _mm_insert_epi8::<3>(v, p(3));
+        let v = _mm_insert_epi8::<4>(v, p(4));
+        let v = _mm_insert_epi8::<5>(v, p(5));
+        let v = _mm_insert_epi8::<6>(v, p(6));
+        _mm_insert_epi8::<7>(v, p(7))
+    }
+}
+
+/// p[-1, 0..15] of a macroblock: [`column8`] twice.
+///
+/// # Safety
+///
+/// As [`column8`], for sixteen samples.
+#[inline(always)]
+unsafe fn column16(at: *const u8, stride: usize) -> __m128i {
+    // SAFETY: the caller's contract, split at the eighth sample.
+    unsafe { _mm_unpacklo_epi64(column8(at, stride), column8(at.add(8 * stride), stride)) }
+}
