+unsafe fn last_column8(rows: &[__m128i; 4]) -> __m128i {
+    // SAFETY: register operations (AVX2 is available, the caller's
+    // contract), and loads of a static table's 16-byte entries.
+    unsafe {
+        let [r0, r1, r2, r3] = *rows;
