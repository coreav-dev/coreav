+
+#[cfg(feature = "probe-pad")]
+/// Probe only (not for merge): `N` independent one-uop instructions, the
+/// CAVLC block parse cut's predicted instructions at one of its sites.
+#[inline(always)]
+pub(crate) fn pad<const N: usize>(a: u64) {
+    for _ in 0..N {
+        // SAFETY: register arithmetic only; no memory, stack or flags.
+        unsafe {
+            core::arch::asm!(
+                "lea {o}, [{a} + {a}]",
+                o = out(reg) _, a = in(reg) a, options(nomem, nostack, preserves_flags)
+            );
+        }
+    }
+}
