+
+/// Probe only (not for merge): 156 independent one-uop instructions, about
+/// the residual block dispatch's instructions a coded block, added to every
+/// coded residual block.
+#[inline(always)]
+pub(crate) fn pad(a: u64) {
+    macro_rules! pad12 {
+        () => {
+            // SAFETY: register arithmetic only; no memory, stack or flags.
+            unsafe {
+                core::arch::asm!(
+                    "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]",
+                    "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]",
+                    "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]",
+                    "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]", "lea {o}, [{a} + {a}]",
+                    o = out(reg) _, a = in(reg) a, options(nomem, nostack, preserves_flags)
+                );
+            }
+        };
+    }
+    pad12!(); pad12!(); pad12!(); pad12!(); pad12!(); pad12!(); pad12!();
+    pad12!(); pad12!(); pad12!(); pad12!(); pad12!(); pad12!();
+}
