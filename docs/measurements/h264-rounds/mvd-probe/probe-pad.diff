+
+#[cfg(feature = "probe-pad")]
+/// Probe only (not for merge): `N` independent one-uop instructions, the
+/// part a cut of the mvd sites would remove there.
+#[inline(always)]
+pub(crate) fn pad<const N: usize>(a: u64) {
+    // SAFETY: register arithmetic only; no memory, stack or flags.
+    unsafe {
+        core::arch::asm!(
+            ".rept {n}", "lea {o}, [{a} + {a}]", ".endr",
+            n = const N, o = out(reg) _, a = in(reg) a,
+            options(nomem, nostack, preserves_flags)
+        );
+    }
+}
